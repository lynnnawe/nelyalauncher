<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Nelya-Setup</AssemblyName>
    <RootNamespace>NelyaSetup</RootNamespace>
    <ApplicationIcon>..\assets\nelya.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.3</Version>
    <Product>nelya setup</Product>
    <Company>nelya</Company>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Payload>..\dist\Nelya.exe</Payload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web\js\ascii.js" LogicalName="web/ascii.js" />
    <EmbeddedResource Include="..\web\js\stars.js" LogicalName="web/stars.js" />
    <EmbeddedResource Include="..\web\img\logo.png" LogicalName="web/logo.png" />
    <EmbeddedResource Include="..\assets\nelya.ico" LogicalName="nelya.ico" />
    <EmbeddedResource Include="$(Payload)" LogicalName="payload/Nelya.exe" />
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4258.31\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="lib/Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4258.31\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="lib/Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4258.31\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="lib/WebView2Loader.dll" />
  </ItemGroup>

</Project>
